# Copy to .env and fill in real values. .env is gitignored and must never be
# committed. Required only by eval/score_rule_extraction_corrections.py's
# --live mode (Mode A: scoring against real reviewer edits in bim-guard's
# live rule_extraction_drafts table) — everything else in this repo runs
# without these set.

# Supabase project connection (Project Settings > API on the bim-guard
# Supabase dashboard). The anon key is meant to be public and is scoped by
# RLS, not secrecy, but is still kept out of git as a matter of hygiene.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional: enables signing in as a dev test user (password auth instead of
# Google OAuth) so score_rule_extraction_corrections.py --live can
# authenticate without a browser flow. Seed the account first from the
# bim-guard checkout with `uv run python scripts/seed_dev_auth_user.py`.
DEV_AUTH_EMAIL=
DEV_AUTH_PASSWORD=

# Optional: path to an adjacent bim-guard checkout, for scripts that import
# bim-guard's app.* modules directly (eval_config.setup_bimguard_path()
# defaults to a sibling ../bim-guard directory if this is unset).
# BIMGUARD_PATH=/path/to/bim-guard

# Optional: LLM provider keys, needed only by eval_harness.py (LLM-as-judge)
# and score_rule_extraction.py / ori_bridge.py's rule-generation calls.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
