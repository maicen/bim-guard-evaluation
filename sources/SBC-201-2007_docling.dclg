  </page_header>
  <text>
    <location value="226"/>
    <location value="38"/>
    <location value="286"/>
    <location value="43"/>
    TABLE 8.16.1
  </text>
  <heading level="2">
    <location value="164"/>
    <location value="45"/>
    <location value="348"/>
    <location value="51"/>
