    <layer value="furniture"/>
    <location value="254"/>
    <location value="23"/>
    <location value="454"/>
    <location value="28"/>
    ROOF ASSEMBLIES AND ROOFTOP STRUCTURES
  </page_header>
  <heading level="2">
    <location value="153"/>
    <location value="37"/>
    <location value="362"/>
    <location value="51"/>
    TABLE 6.7.10.2 BUILT-UP ROOFING MATERIAL STANDARDS
  </heading>
