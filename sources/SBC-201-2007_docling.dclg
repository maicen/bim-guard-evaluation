    <layer value="furniture"/>
    <location value="246"/>
    <location value="477"/>
    <location value="266"/>
    <location value="482"/>
    2007
  </page_footer>
  <page_footer>
    <layer value="furniture"/>
    <location value="440"/>
    <location value="477"/>
    <location value="453"/>
    <location value="482"/>
    9/6
  </page_footer>

  <page_header>
    <layer value="furniture"/>
    <location value="388"/>
    <location value="23"/>
    <location value="454"/>
    <location value="29"/>
    ACCESSIBILITY
  </page_header>
  <table>
    <location value="125"/>
    <location value="55"/>
    <location value="387"/>
    <location value="181"/>
    <caption>
      <location value="183"/>
      <location value="38"/>
      <location value="331"/>
      <location value="51"/>
