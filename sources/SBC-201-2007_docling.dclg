    <location value="436"/>
    <location value="477"/>
    <location value="454"/>
    <location value="482"/>
    2/62
  </page_footer>
  <page_break/>
  <page_header>
    <layer value="furniture"/>
    <location value="287"/>
    <location value="23"/>
    <location value="453"/>
    <location value="29"/>
    USE AND OCCUPANCY CLASSIFICATION
  </page_header>
  <list class="ordered">
    <ldiv>
      <marker>2.3</marker>
    </ldiv>
    <location value="139"/>
    <location value="38"/>
    <location value="358"/>
    <location value="44"/>
    Unstable reactive materials, Class 3 detonable.
    <ldiv>
      <marker>2.4</marker>
    </ldiv>
    <location value="139"/>
    <location value="46"/>
