    <nl/>
    <fcel/>
    Anchored masonry veneer
    <fcel/>
    66.7
    <nl/>
    <fcel/>
    Aluminum siding
    <fcel/>
    0.5
    <nl/>
    <fcel/>
    Asbestos-cement boards
    <fcel/>
    3.2
    <nl/>
    <fcel/>
    Asbestos shingles
    <fcel/>
    4
    <nl/>
    <fcel/>
    Cold-rolled copper d
    <fcel/>
    0.6
    <nl/>
    <fcel/>
    Copper shingles d
    <fcel/>
    0.4
    <nl/>
    <fcel/>
    Exterior plywood (with sheathing)
    <fcel/>
