    <location value="355"/>
    Motor fuel-dispensing facilities
  </text>
  <text>
    <location value="108"/>
    <location value="357"/>
    <location value="217"/>
    <location value="363"/>
    Retail or wholesale stores
  </text>
  <text>
    <location value="108"/>
    <location value="365"/>
    <location value="160"/>
    <location value="371"/>
    Sales rooms
  </text>
