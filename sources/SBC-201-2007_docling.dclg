    <layer value="furniture"/>
    <location value="246"/>
    <location value="478"/>
    <location value="266"/>
    <location value="483"/>
    2007
  </page_footer>
  <page_footer>
    <layer value="furniture"/>
    <location value="436"/>
    <location value="478"/>
    <location value="453"/>
    <location value="483"/>
