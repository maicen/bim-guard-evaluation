  </text>
  <text>
    <location value="61"/>
    <location value="289"/>
    <location value="300"/>
    <location value="296"/>
    THERMOSETTING MATERIAL. See Section 11.2.1.
  </text>
  <text>
    <location value="61"/>
    <location value="309"/>
    <location value="177"/>
    <location value="316"/>
    TOXIC. See Section 2.7.2.
  </text>
  <text>
    <location value="61"/>
    <location value="330"/>
