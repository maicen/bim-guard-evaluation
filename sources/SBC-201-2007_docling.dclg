    <location value="29"/>
    MEANS OF EGRESS
  </page_header>
  <text>
    <location value="123"/>
    <location value="38"/>
    <location value="454"/>
    <location value="53"/>
    provided that the story or space complies with Section 8.14.1 as a space with one means of egress.
  </text>
  <table>
    <location value="87"/>
    <location value="75"/>
    <location value="426"/>
    <location value="185"/>
    <caption>
      <location value="191"/>
      <location value="59"/>
