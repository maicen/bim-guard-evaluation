  </page_header>
  <text>
    <location value="218"/>
    <location value="53"/>
    <location value="266"/>
    <location value="59"/>
    Table 9.25.5.2.
  </text>
  <heading level="2">
    <location value="161"/>
    <location value="61"/>
    <location value="321"/>
    <location value="67"/>
    Ratio of Outboard to Inboard Thermal Resistance
  </heading>
  <text>
    <location value="183"/>
    <location value="68"/>
    <location value="301"/>
    <location value="74"/>
    Forming Part of Sentence 9.25.5.2.(1)
  </text>
  <table>
    <location value="29"/>
    <location value="82"/>
