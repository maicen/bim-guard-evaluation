  <page_header>
    <layer value="furniture"/>
    <location value="428"/>
    <location value="22"/>
    <location value="488"/>
    <location value="28"/>
    9.23.14.2.
  </page_header>
  <text>
    <location value="48"/>
    <location value="363"/>
    <location value="57"/>
    <location value="368"/>
    r3
  </text>
  <heading level="2">
    <location value="244"/>
    <location value="53"/>
    <location value="300"/>
    <location value="59"/>
    Table 9.23.13.11.
  </heading>
  <heading level="2">
    <location value="217"/>
    <location value="61"/>
    <location value="325"/>
    <location value="67"/>
    Maximum Roof Truss Deflections
  </heading>
  <text>
    <location value="210"/>
    <location value="68"/>
    <location value="334"/>
    <location value="74"/>
    Forming Part of Sentence 9.23.13.11.(1)
  </text>
  <table>
    <location value="60"/>
    <location value="82"/>
    <location value="483"/>
    <location value="138"/>
    <ched/>
    Truss Span
