  <page_header>
    <layer value="furniture"/>
    <location value="30"/>
    <location value="22"/>
    <location value="89"/>
    <location value="28"/>
    9.10.19.7.
  </page_header>
  <page_header>
    <layer value="furniture"/>
    <location value="160"/>
    <location value="22"/>
    <location value="347"/>
    <location value="28"/>
