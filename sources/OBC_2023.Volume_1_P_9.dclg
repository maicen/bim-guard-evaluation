  </heading>
  <list class="ordered">
    <ldiv>
      <marker>(1)</marker>
    </ldiv>
    <location value="42"/>
    <location value="228"/>
    <location value="139"/>
    <location value="233"/>
    This Section applies to,
    <ldiv/>
    <location value="42"/>
    <location value="235"/>
    <location value="90"/>
    <location value="240"/>
    (a) glass in,
    <ldiv/>
    <location value="67"/>
    <location value="242"/>
    <location value="271"/>
    <location value="248"/>
    (i) interior windows and interior doors and their sidelights,
    <ldiv/>
    <location value="65"/>
    <location value="250"/>
    <location value="135"/>
    <location value="255"/>
    (ii) clothes closets,
    <ldiv/>
    <location value="63"/>
    <location value="257"/>
    <location value="246"/>
    <location value="263"/>
    (iii) site-built exterior windows, doors and skylights,
    <ldiv/>
    <location value="63"/>
    <location value="265"/>
    <location value="184"/>
    <location value="270"/>
    (iv) shower or bathtub enclosures,
    <ldiv/>
    <location value="66"/>
    <location value="272"/>
    <location value="195"/>
    <location value="278"/>
    (v) glazed panels and partitions , and
    <ldiv/>
    <location value="42"/>
    <location value="280"/>
    <location value="139"/>
    <location value="285"/>
    (b) the protection of glass.
  </list>
  <heading level="2">
    <location value="30"/>
    <location value="297"/>
    <location value="225"/>
    <location value="303"/>
    9.6.1.2. Material Standards for Glass
  </heading>
  <list class="ordered">
    <ldiv>
      <marker>(1)</marker>
    </ldiv>
    <location value="42"/>
    <location value="313"/>
    <location value="140"/>
    <location value="319"/>
    Glass shall conform to,
    <ldiv/>
    <location value="42"/>
    <location value="321"/>
    <location value="268"/>
    <location value="326"/>
<![CDATA[(a) CAN/CGSB-12.1M, 'Tempered or Laminated Safety Glass,']]>    
    <ldiv/>
    <location value="42"/>
    <location value="328"/>
    <location value="220"/>
    <location value="334"/>
<![CDATA[(b) CAN/CGSB-12.2M, 'Flat, Clear Sheet Glass',]]>    
    <ldiv/>
    <location value="42"/>
    <location value="335"/>
    <location value="219"/>
    <location value="341"/>
<![CDATA[(c) CAN/CGSB-12.3M, 'Flat, Clear Float Glass',]]>    
    <ldiv/>
    <location value="42"/>
    <location value="343"/>
    <location value="217"/>
    <location value="348"/>
<![CDATA[(d) CAN/CGSB-12.4M, 'Heat Absorbing Glass,']]>    
    <ldiv/>
    <location value="42"/>
    <location value="350"/>
    <location value="207"/>
    <location value="356"/>
<![CDATA[(e) CAN/CGSB12.8, 'Insulating Glass Units',]]>    
    <ldiv/>
    <location value="42"/>
    <location value="358"/>
    <location value="257"/>
    <location value="363"/>
<![CDATA[(f) CAN/CGSB-12.10M, 'Glass, Light and Heat Reflecting',]]>    
    <ldiv/>
    <location value="42"/>
    <location value="365"/>
    <location value="222"/>
    <location value="371"/>
<![CDATA[(g) CAN/CGSB-12.11M, 'Wired Safety Glass', or]]>    
    <ldiv/>
    <location value="42"/>
    <location value="373"/>
    <location value="289"/>
    <location value="378"/>
<![CDATA[(h) ASTM E2190, 'Insulating Glass Unit Performance and Evaluation'.]]>    
    <ldiv>
      <marker>(2)</marker>
    </ldiv>
    <location value="42"/>
    <location value="388"/>
    <location value="426"/>
    <location value="401"/>
<![CDATA[Mirrored glass doors are permitted to be used only at the entrance to clothes closets and shall conform to the requirements of CAN/CGSB-82.6M, 'Doors, Mirrored Glass, Sliding or Folding, Wardrobe'.  (See Appendix A.)]]>    
    <ldiv>
      <marker>(3)</marker>
    </ldiv>
    <location value="42"/>
    <location value="410"/>
    <location value="431"/>
    <location value="423"/>
<![CDATA[Mirrored glass doors reinforced with a film backing shall meet the impact resistance requirements specified in CAN/CGSB-12.5M, 'Mirrors, Silvered'.]]>    
  </list>
