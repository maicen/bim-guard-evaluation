    <location value="60"/>
    <location value="55"/>
    <location value="229"/>
    <location value="62"/>
    9.30.3.  Wood Strip Flooring
  </heading>
  <heading level="2">
    <location value="60"/>
    <location value="75"/>
    <location value="163"/>
    <location value="81"/>
    9.30.3.1.  Thickness
  </heading>
  <list class="ordered">
    <ldiv>
      <marker>(1)</marker>
    </ldiv>
    <location value="72"/>
    <location value="92"/>
    <location value="324"/>
    <location value="97"/>
    The thickness of wood strip flooring shall conform to Table 9.30.3.1.
  </list>
  <text>
    <location value="216"/>
