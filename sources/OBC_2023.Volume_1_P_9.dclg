  <list class="ordered">
    <ldiv>
      <marker>(1)</marker>
    </ldiv>
    <location value="72"/>
    <location value="133"/>
    <location value="403"/>
    <location value="138"/>
    Wood furring for the attachment of wall and ceiling finishes shall conform to Table 9.29.3.1.
  </list>
