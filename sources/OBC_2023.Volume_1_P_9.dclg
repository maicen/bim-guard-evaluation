    <layer value="furniture"/>
    <location value="30"/>
    <location value="22"/>
    <location value="83"/>
    <location value="28"/>
    9.27.8.5.
  </page_header>
  <page_header>
    <layer value="furniture"/>
    <location value="160"/>
    <location value="22"/>
