    Notes to Table 9.8.8.2.:
  </heading>
  <list class="ordered">
    <ldiv>
      <marker>(1)</marker>
    </ldiv>
    <location value="60"/>
    <location value="252"/>
    <location value="253"/>
    <location value="258"/>
    <content> The load that creates the most critical condition shall apply.</content>
    <ldiv>
      <marker>(2)</marker>
    </ldiv>
    <location value="60"/>
