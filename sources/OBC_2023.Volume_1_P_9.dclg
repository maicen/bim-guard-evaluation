    <location value="59"/>
    r3
  </text>
  <heading level="2">
    <location value="220"/>
    <location value="53"/>
    <location value="264"/>
    <location value="59"/>
    Table 9.8.7.1.
  </heading>
  <heading level="2">
    <location value="190"/>
    <location value="61"/>
    <location value="292"/>
    <location value="67"/>
    Handrails for Stairs and Ramps
  </heading>
  <text>
    <location value="185"/>
    <location value="68"/>
    <location value="299"/>
    <location value="74"/>
    Forming Part of Sentence 9.8.7.1.(1)
  </text>
  <table>
    <location value="29"/>
    <location value="82"/>
    <location value="452"/>
    <location value="154"/>
