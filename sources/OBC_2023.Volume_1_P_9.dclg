  <heading level="2">
    <location value="63"/>
    <location value="421"/>
    <location value="143"/>
    <location value="426"/>
    Notes to Table 9.32.3.5.:
  </heading>
  <list class="ordered">
    <ldiv>
      <marker>(1)</marker>
    </ldiv>
    <location value="63"/>
    <location value="429"/>
    <location value="308"/>
    <location value="435"/>
    <content> Where flexible duct is used, the duct diameter shall be increased by 25 mm.</content>
  </list>
