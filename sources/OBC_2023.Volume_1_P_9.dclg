    <location value="218"/>
    <location value="53"/>
    <location value="266"/>
    <location value="59"/>
    Table 9.23.3.1.
  </heading>
  <heading level="2">
    <location value="193"/>
    <location value="61"/>
    <location value="289"/>
    <location value="67"/>
    Diameter of Nails for Framing
  </heading>
  <text>
    <location value="183"/>
    <location value="68"/>
    <location value="301"/>
    <location value="74"/>
    Forming Part of Sentence 9.23.3.1.(2)
  </text>
  <table>
    <location value="95"/>
    <location value="82"/>
    <location value="387"/>
    <location value="147"/>
    <ched/>
