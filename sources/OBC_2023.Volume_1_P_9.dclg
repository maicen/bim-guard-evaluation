    <location value="377"/>
    <location value="28"/>
    2012 Building Code Compendium
  </page_header>
  <page_header>
    <layer value="furniture"/>
    <location value="441"/>
    <location value="22"/>
    <location value="488"/>
    <location value="28"/>
    9.8.9.6.
  </page_header>
  <picture>
    <location value="59"/>
    <location value="10"/>
    <location value="122"/>
    <location value="27"/>
