  </page_header>
  <page_header>
    <layer value="furniture"/>
    <location value="428"/>
    <location value="22"/>
    <location value="488"/>
    <location value="28"/>
    9.20.10.1.
  </page_header>
  <picture>
    <location value="59"/>
    <location value="10"/>
    <location value="122"/>
    <location value="27"/>
  </picture>
  <list>
    <ldiv/>
    <location value="72"/>
    <location value="54"/>
    <location value="187"/>
    <location value="59"/>
    (b) not less than 0.76 mm thick,
    <ldiv/>
    <location value="72"/>
    <location value="61"/>
    <location value="180"/>
    <location value="67"/>
    (c) not less than 22 mm wide,
    <ldiv/>
    <location value="72"/>
    <location value="68"/>
    <location value="242"/>
    <location value="74"/>
    (d) shaped to provide a key with the mortar, and
    <ldiv/>
    <location value="72"/>
    <location value="76"/>
    <location value="233"/>
    <location value="81"/>
    (e) spaced in accordance with Table 9.20.9.5.
  </list>
  <heading level="2">
    <location value="248"/>
    <location value="91"/>
    <location value="296"/>
    <location value="97"/>
    Table 9.20.9.5.
  </heading>
  <heading level="2">
    <location value="239"/>
    <location value="98"/>
    <location value="303"/>
    <location value="104"/>
    Veneer Tie Spacing
  </heading>
  <text>
    <location value="213"/>
    <location value="106"/>
    <location value="331"/>
    <location value="111"/>
    Forming Part of Sentence 9.20.9.5.(1)
  </text>
  <table>
    <location value="60"/>
    <location value="119"/>
    <location value="483"/>
    <location value="166"/>
    <ched/>
    Maximum Vertical Spacing, mm
    <ched/>
    Maximum Horizontal Spacing, mm
    <nl/>
    <fcel/>
    406
    <fcel/>
    813
    <nl/>
    <fcel/>
    508
    <fcel/>
    610
    <nl/>
    <fcel/>
    610
    <fcel/>
