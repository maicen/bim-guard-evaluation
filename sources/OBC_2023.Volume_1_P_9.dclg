  <heading level="2">
    <location value="60"/>
    <location value="55"/>
    <location value="158"/>
    <location value="61"/>
    9.29.2.2.  Materials
  </heading>
  <list class="ordered">
    <ldiv>
      <marker>(1)</marker>
    </ldiv>
    <location value="72"/>
    <location value="71"/>
    <location value="450"/>
    <location value="84"/>
    Waterproof finish shall consist of ceramic, plastic or metal tile, sheet vinyl, tempered hardboard, laminated thermosetting decorative sheets or linoleum.
  </list>
  <heading level="2">
    <location value="60"/>
    <location value="96"/>
    <location value="191"/>
    <location value="103"/>
    9.29.3.  Wood Furring
  </heading>
