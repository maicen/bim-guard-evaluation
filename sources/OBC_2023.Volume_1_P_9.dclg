  <page_header>
    <layer value="furniture"/>
    <location value="428"/>
    <location value="22"/>
    <location value="488"/>
    <location value="28"/>
    9.20.17.3.
  </page_header>
  <picture>
    <location value="59"/>
    <location value="10"/>
    <location value="122"/>
    <location value="27"/>
  </picture>
  <heading level="2">
    <location value="246"/>
    <location value="53"/>
    <location value="298"/>
    <location value="59"/>
    Table 9.20.16.1.
  </heading>
  <heading level="2">
    <location value="206"/>
    <location value="61"/>
    <location value="336"/>
    <location value="67"/>
    Minimum Requirements for Galvanizing
  </heading>
  <text>
    <location value="212"/>
    <location value="68"/>
    <location value="333"/>
    <location value="74"/>
    Forming Part of Sentence 9.20.16.1.(1)
  </text>
  <table>
    <location value="60"/>
    <location value="82"/>
    <location value="482"/>
    <location value="138"/>
