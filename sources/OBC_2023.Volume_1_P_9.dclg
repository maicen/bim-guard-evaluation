    <layer value="furniture"/>
    <location value="30"/>
    <location value="22"/>
    <location value="83"/>
    <location value="28"/>
    9.25.5.2.
  </page_header>
  <page_header>
    <layer value="furniture"/>
    <location value="160"/>
    <location value="22"/>
    <location value="347"/>
    <location value="28"/>
