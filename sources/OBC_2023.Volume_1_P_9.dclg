  <heading level="2">
    <location value="30"/>
    <location value="244"/>
    <location value="200"/>
    <location value="251"/>
    9.34.3.  Emergency Lighting
  </heading>
  <heading level="2">
    <location value="30"/>
    <location value="264"/>
    <location value="182"/>
    <location value="270"/>
    9.34.3.1.  Emergency Lighting
  </heading>
  <list class="ordered">
    <ldiv>
      <marker>(1)</marker>
    </ldiv>
    <location value="42"/>
    <location value="281"/>
    <location value="249"/>
    <location value="286"/>
    Emergency lighting shall conform to Subsection 9.9.12.
  </list>
