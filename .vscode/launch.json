{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "purpose": [
                "debug-in-terminal"
            ]
        },
        {
            "name": "Python Debugger: Convert PDF to DLNG (pdf_to_dlng.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/pdf_to_dlng.py",
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}